# Dependencias
node_modules/

# Variables de entorno (contienen configuración local, nunca se versionan)
.env

# Base de datos SQLite (datos reales del negocio, no van al repo)
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Logs de la aplicación
logs/*
!logs/.gitkeep

# Backups automáticos de la base de datos (datos reales del negocio)
backups/*
!backups/.gitkeep

# Copia en disco del registro de auditoría (append-only, ver ADR 0018) —
# datos reales del negocio, no van al repo
auditoria/*
!auditoria/.gitkeep

# Archivos de sistema operativo / editor / herramientas locales
.DS_Store
Thumbs.db
.vscode/
.claude/
