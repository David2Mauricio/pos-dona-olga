# Copia este archivo como .env y ajusta los valores para tu entorno local.
# .env nunca se sube al repositorio (ver .gitignore).

# Puerto en el que escucha el servidor Express
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV=development

# Ruta del archivo de base de datos SQLite (relativa a la raíz del proyecto)
DB_PATH=./data/pos.sqlite

# Si una venta descuenta stock automáticamente al confirmarse. Provisional
# hasta que la dueña confirme su preferencia real (ver ADR 0003).
DESCONTAR_STOCK_AUTOMATICO=true

# Días de anticipación para marcar un lote como "próximo a vencer" en
# GET /api/vencimientos/alertas (ver ADR 0006).
DIAS_ALERTA_VENCIMIENTO=3
